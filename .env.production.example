# Copy to `.env.production` for local production-like builds (never commit secrets).
# On Render, set these in the dashboard for Amynest-backend / Amynest-live-1.

# ─── Profile ─────────────────────────────────────────────────────────────────
AMYNEST_ENV=production
NODE_ENV=production

# ─── API server ──────────────────────────────────────────────────────────────
PORT=10000
API_PUBLIC_URL=https://amynest-backend-dykj.onrender.com
LOG_LEVEL=info
# Must be true on Render for automatic push (morning routine, insights, task reminders).
NOTIFICATIONS_ENABLED=true
BACKGROUND_TASKS_ENABLED=true
# Co-parent invite/accept (Phase 1 retired by default). Set to 1 to re-enable.
# CO_PARENT_FEATURE_ENABLED=1

# Optional: protects /api/healthz/env from public fingerprinting in production.
# INTERNAL_HEALTH_SECRET=

# Cron-only digest (default every 4h, Asia/Kolkata). Sends EMAIL first, then an
# optional Slack summary. Telegram is NOT used by the digest (only real-time alerts).
ADMIN_HEALTH_DIGEST_ENABLED=true
ADMIN_ALERT_EMAIL=ankur6779@gmail.com
# Slack INCOMING WEBHOOK URL (not a bot token). Create at api.slack.com/apps → Incoming Webhooks.
ADMIN_ALERT_SLACK_WEBHOOK_URL=
# Optional: real-time critical incident alerts to Telegram (separate from the digest).
# ADMIN_ALERT_TELEGRAM_BOT_TOKEN=
# ADMIN_ALERT_TELEGRAM_CHAT_ID=
# Optional overrides:
# ADMIN_HEALTH_DIGEST_CRON=0 */4 * * *
# ADMIN_HEALTH_DIGEST_TZ=Asia/Kolkata
# ADMIN_HEALTH_DIGEST_SLACK=true   # set false to send email only

GOOGLE_API_KEY=
OPENAI_API_KEY=
# OpenAI TTS (sole provider): female voice + accent via instructions
# OPENAI_TTS_VOICE=coral|nova|shimmer  (default: coral for indian, nova for us)
# OPENAI_TTS_ACCENT=indian|us           (default: indian — Indian English intonation)
# OPENAI_TTS_INSTRUCTIONS=              (optional full override)
# Cache OpenAI MP3 on server (GCS when configured; Postgres bytea fallback). Clients always use /api/tts/audio/…
TTS_USE_GCS=true
DATABASE_URL=postgresql://user:pass@host:5432/amynest_prod
# Minimum 20 recommended — getEntitlements() runs ~18 parallel queries per call.
PG_POOL_MAX=20
# Abort any single query after 30s (prevents runaway scans from holding connections).
PG_STATEMENT_TIMEOUT_MS=30000
# Cap GET /routines list size (default 100, max 500).
ROUTINES_LIST_MAX=100

# Redis (BullMQ AI queue) — REQUIRED in production; same URL on API + Worker
REDIS_URL=redis://default:password@redis-host:6379
# Dedicated AI worker — REQUIRED in production (no inline AI on API tier)
WORKER_ENABLED=true
AI_MAX_CONCURRENT_JOBS=25
# Default worker budget for most AI jobs (ms). Coach jobs use COACH_WORKER_TIMEOUT_MS (45s) in code.
AI_JOB_TIMEOUT_MS=60000
# Coach win-generation stack (see lib/coach-journey/src/ai-timeouts.ts):
# OpenAI 30s → Worker 45s → Queue poll 50s → Gateway 65s → Client 90s

# Optional error monitoring — set DSN in Render dashboard.
SENTRY_DSN=
SENTRY_RELEASE=
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_USER_HASH_SALT=
# Web (Vite build-time)
VITE_SENTRY_DSN=
VITE_SENTRY_RELEASE=
VITE_SENTRY_TRACES_SAMPLE_RATE=0.1
VITE_SENTRY_REPLAY_SAMPLE_RATE=0.1
# AI dead-letter queue (Redis list ai:dlq:entries)
AI_DLQ_MAX_ENTRIES=500
# API long-path timeout defaults to COACH_GATEWAY_TIMEOUT_MS (65s).
# meals.ai_generate: OpenAI abort must finish before worker race (worker >= openai + margin).
MEALS_AI_OPENAI_TIMEOUT_MS=40000
# MEALS_AI_WORKER_TIMEOUT_MS=45000
MEALS_AI_MAX_COMPLETION_TOKENS=1500
# Production BullMQ: 0 = immediate 202; dev in-memory may use 9000
AI_HTTP_WAIT_MS=0
AI_JOB_RESULT_TTL_SEC=600

# ─── Web (Vite) ──────────────────────────────────────────────────────────────
VITE_AMYNEST_ENV=production
# Production web: same-origin /api/* via Cloudflare Worker (infra/cloudflare/amynest-api-proxy/).
# Capacitor iOS / local builds may still use amynest-backend-dykj.onrender.com when unset on non-amynest hosts.
VITE_APP_API_ORIGIN=https://www.amynest.in

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_VAPID_KEY=
# Co-parent invite UI (Phase 1 retired by default). Set to 1 with API flag to restore.
# VITE_FF_CO_PARENT=1

# TTS Phase-2 MSE streaming — leave unset/false during outage recovery (Phase-1 blob playback).
# VITE_ENABLE_MSE_STREAMING=true
# ENABLE_MSE_STREAMING=true

# ─── Expo (EAS / release builds) ─────────────────────────────────────────────
EXPO_PUBLIC_AMYNEST_ENV=production
EXPO_PUBLIC_API_ORIGIN=https://amynest-backend-dykj.onrender.com

EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
