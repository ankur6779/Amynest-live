# Copy to `.env.development` at the repo root (never commit real secrets).
# Loaded by: api-server (dotenv), Vite web (`--mode development`), Expo (`.env.development`).

# ─── Profile ─────────────────────────────────────────────────────────────────
AMYNEST_ENV=development
NODE_ENV=development

# ─── API server (local) ──────────────────────────────────────────────────────
PORT=5000
API_PUBLIC_URL=http://localhost:5000
LOG_LEVEL=debug
# Co-parent invite/accept (Phase 1 retired by default). Set to 1 to re-enable.
# CO_PARENT_FEATURE_ENABLED=1

# Backend secrets (use dev/staging keys — not production)
GOOGLE_API_KEY=
ELEVENLABS_API_KEY=
# Pre-generated static TTS (pnpm run generate:static-audio)
DEFAULT_OBJECT_STORAGE_BUCKET_ID=
GCS_SERVICE_ACCOUNT_JSON=
DATABASE_URL=postgresql://user:pass@localhost:5432/amynest_dev
# Growth OS admin: Firebase UID allowlist and/or trusted emails
# ADMIN_USER_IDS=firebase_uid_here
ADMIN_GROWTH_EMAILS=demo@amynest.in
# Phonics daily/weekly test session tokens (32+ chars; optional in dev — auto-derived)
SESSION_SECRET=dev-phonics-session-secret-32chars-min!!
# Birth Sky at-rest field encryption (Pack 8 Part 4). Prefer 64-hex; else ≥32 chars.
# Production: set explicitly. Dev: falls back to SESSION_SECRET derive if unset.
# BIRTH_SKY_FIELD_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
# Amy Astro Intelligence — public GA default ON when unset (client + API).
# Kill switch: VITE_FF_BIRTH_SKY=0 and/or BIRTH_SKY_PUBLIC_ENABLED=0 (allowlist-only).
# VITE_FF_BIRTH_SKY=0
# VITE_FF_BIRTH_SKY_ALLOWLIST=
# BIRTH_SKY_ALLOWLIST=
# BIRTH_SKY_PUBLIC_ENABLED=0

# Optional: weekly recap emails only (not used for signup verification)
# RESEND_API_KEY=
# EMAIL_FROM=AmyNest <hello@amynest.in>

# TTS: OpenAI only (gpt-4o-mini-tts). Pre-generate static catalog with pnpm run generate:static-audio
TTS_USE_GCS=false

# OpenAI / integrations (if used locally) — GPT scripts only
OPENAI_API_KEY=
AI_INTEGRATIONS_OPENAI_API_KEY=
AI_INTEGRATIONS_OPENAI_BASE_URL=
# Product chat catalog (Ask Amy / Tutor / Coach / Talk with Amy = FAST).
# OPENAI_CHAT_MODEL is a deprecated LEGACY alias only — it does not change Birth Sky tiers.
# OPENAI_CHAT_MODEL_FAST=gpt-5-mini
# OPENAI_CHAT_MODEL_REASONING=gpt-5
# OPENAI_CHAT_MODEL_LEGACY=gpt-4o-mini
# Google AI Studio media stack — keep separate from OPENAI_API_KEY
GEMINI_API_KEY=
# Keep false until `pnpm amynest:test-gemini` PASS (TEST_GEMINI_REPORT.md)
AMYNEST_GEMINI_ENABLED=false
AMYNEST_VEO_ENABLED=false
AMYNEST_VEO_TIER=daily
AMYNEST_VEO_MODEL=veo-3.1-fast-generate-preview
# Permanent primary video generation source (compose + production runs).
# kie = cheapest measured bakeoff winner; google = fallback only.
AMYNEST_VIDEO_PROVIDER=kie
AMYNEST_AUDIO_PROVIDER=kie
AMYNEST_KIE_ENABLED=true
AMYNEST_KIE_VEO_MODEL=veo3_fast
AMYNEST_KIE_VEO_RESOLUTION=1080p
# AMYNEST_KIE_TTS_VOICE=Kore
# AMYNEST_KIE_SUNO_MODEL=V4
# AMYNEST_VIDEO_FALLBACK_GOOGLE=0  # set 0 to disable Google fallback on KIE failure
AMYNEST_GEMINI_SCRIPT_MODEL=gemini-3.6-flash
AMYNEST_GEMINI_IMAGE_MODEL=imagen-4.0-fast-generate-001
AMYNEST_GEMINI_TTS_MODEL=gemini-3.1-flash-tts-preview
AMYNEST_GEMINI_MUSIC_ENABLED=false
AMYNEST_SCRIPT_PROVIDER=openai
AMYNEST_FALLBACK_PROVIDER=mock

# Speech Coach V2 Realtime WebRTC (GA default: gpt-realtime; preview slugs are rejected)
# SPEECH_COACH_V2_REALTIME_MODEL=gpt-realtime

# ─── Web (Vite / kidschedule) ─────────────────────────────────────────────────
VITE_AMYNEST_ENV=development
# Point at local API: set VITE_USE_LOCAL_API=1 and leave origin unset, or set explicitly:
VITE_USE_LOCAL_API=1
VITE_APP_API_ORIGIN=http://localhost:5000
# Dev sign-in prefill (development only — never set in production)
VITE_DEMO_LOGIN_EMAIL=demo@amynest.in
VITE_DEMO_LOGIN_PASSWORD=AmyNest@2025

# Amy voice: optional ElevenLabs layer after OpenAI fails (needs ELEVENLABS_API_KEY on backend)
# TTS_ELEVENLABS_FALLBACK_ENABLED=true

# Static audio strict mode (dev only)
# VITE_STATIC_AUDIO_STRICT_MODE=true

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_VAPID_KEY=
# Co-parent invite UI (Phase 1 retired by default). Set to 1 with API flag to restore.
# VITE_FF_CO_PARENT=1
# Guest "Try first" (Android native) — opt-in. Requires Firebase Anonymous Auth enabled.
# VITE_FF_GUEST_TRY_FIRST=1

# Pre-signup re-engagement (Phase A: F1 native permission + F4 diagnostics). Parent OFF disables all.
# VITE_FF_PRE_SIGNUP_REENGAGEMENT=false
# VITE_FF_PRE_SIGNUP_PERM_NATIVE=true
# VITE_FF_PRE_SIGNUP_DIAGNOSTICS=true

# Google Analytics 4 — public marketing funnel (/get-app, /features, /guides)
# Create at https://analytics.google.com/ → Admin → Data Streams → Web
# VITE_GA4_MEASUREMENT_ID=G-XXXXXXXXXX

# ─── Expo mobile ─────────────────────────────────────────────────────────────
EXPO_PUBLIC_AMYNEST_ENV=development
EXPO_PUBLIC_USE_LOCAL_API=1
EXPO_PUBLIC_API_ORIGIN=http://localhost:5000
# Legacy alias (still supported):
# EXPO_PUBLIC_DOMAIN=localhost:5000

EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=

# ── Notification intelligence gate ────────────────────────────────────────────
# Governs the full intelligence gate for scheduled pushes: expected-value
# decision engine + copy-level Quality AI + unified Suppression engine, and logs
# persona / parent-value / lifecycle for analytics.
#   off      → no behavior change (default)
#   shadow   → evaluate + log every gate decision, but always dispatch (safe rollout)
#   enforce  → suppress sends the gate rejects (reduces fatigue / disables / uninstalls)
NOTIF_DECISION_ENGINE=off

# ─── YouTube promo automation (scripts/youtube-oauth-setup.mjs) ────────────────
# One-time: node scripts/youtube-oauth-setup.mjs --client-secret=/path/to/client_secret.json
# YOUTUBE_CLIENT_ID=
# YOUTUBE_CLIENT_SECRET=
# YOUTUBE_REFRESH_TOKEN=
# YOUTUBE_REDIRECT_URI=http://127.0.0.1:3333/oauth2callback
# YOUTUBE_DEFAULT_PRIVACY=unlisted
# PROMO_VIDEO_DIR=/absolute/path/to/Promotional images and video new

# ─── Cost-first provider selection (content-engine) ───────────────────────────
# Offline → Cache → API Last. Default ON. Set false only for paid-LLM experiments.
AMYNEST_COST_FIRST=true
# Paid script LLMs are OFF unless explicitly set (mock = Golden Scripts / local):
AMYNEST_SCRIPT_PROVIDER=mock
# Media opt-in (Veo/Imagen/TTS) — does not enable Gemini for text:
# AMYNEST_GEMINI_ENABLED=false
# AMYNEST_VEO_ENABLED=false

# ─── YouTube publishing metadata (content-engine) ─────────────────────────────
# Parent/caregiver audience — do NOT mark Made for Kids unless explicitly true.
# YOUTUBE_MADE_FOR_KIDS=false
# Disclose AI / synthetic media via YouTube status.containsSyntheticMedia
YOUTUBE_AI_DISCLOSURE=true
# Official store / web links used in Shorts descriptions (do not hardcode in code paths)
PLAY_STORE_URL=https://play.google.com/store/apps/details?id=com.amynest.app
APP_STORE_URL=https://apps.apple.com/us/app/amynest-ai-smart-parenting/id6767664343
WEBSITE_URL=https://amynest.in
GET_APP_URL=https://amynest.in/get-app
# Optional playlist IDs (PL…) — autosorted by topic when set
# YOUTUBE_PLAYLIST_STUDY_ZONE=
# YOUTUBE_PLAYLIST_SPEECH=
# YOUTUBE_PLAYLIST_HEALTH=
# YOUTUBE_PLAYLIST_GAMES=
# YOUTUBE_PLAYLIST_PARENT_TIPS=
# YOUTUBE_PLAYLIST_ROUTINE=
# YOUTUBE_PLAYLIST_DEFAULT=

# you.bot unified AI API (pay-as-you-go credits)
YOUBOT_API_KEY=

# kie.ai unified AI API (credit-based) — PRIMARY video generation (Veo i2v)
KIE_API_KEY=
