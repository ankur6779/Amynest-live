# Copy to `.env.development` at the repo root (never commit real secrets).
# Loaded by: api-server (dotenv), Vite web (`--mode development`), Expo (`.env.development`).

# ─── Profile ─────────────────────────────────────────────────────────────────
AMYNEST_ENV=development
NODE_ENV=development

# ─── API server (local) ──────────────────────────────────────────────────────
PORT=5000
API_PUBLIC_URL=http://localhost:5000
LOG_LEVEL=debug
# Co-parent invite/accept (Phase 1 retired by default). Set to 1 to re-enable.
# CO_PARENT_FEATURE_ENABLED=1

# Backend secrets (use dev/staging keys — not production)
GOOGLE_API_KEY=
ELEVENLABS_API_KEY=
# Pre-generated static TTS (pnpm run generate:static-audio)
DEFAULT_OBJECT_STORAGE_BUCKET_ID=
GCS_SERVICE_ACCOUNT_JSON=
DATABASE_URL=postgresql://user:pass@localhost:5432/amynest_dev
# Growth OS admin: Firebase UID allowlist and/or trusted emails
# ADMIN_USER_IDS=firebase_uid_here
ADMIN_GROWTH_EMAILS=demo@amynest.in
# Phonics daily/weekly test session tokens (32+ chars; optional in dev — auto-derived)
SESSION_SECRET=dev-phonics-session-secret-32chars-min!!
# Birth Sky at-rest field encryption (Pack 8 Part 4). Prefer 64-hex; else ≥32 chars.
# Production: set explicitly. Dev: falls back to SESSION_SECRET derive if unset.
# BIRTH_SKY_FIELD_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
# Amy Astro Intelligence — public GA default ON when unset (client + API).
# Kill switch: VITE_FF_BIRTH_SKY=0 and/or BIRTH_SKY_PUBLIC_ENABLED=0 (allowlist-only).
# VITE_FF_BIRTH_SKY=0
# VITE_FF_BIRTH_SKY_ALLOWLIST=
# BIRTH_SKY_ALLOWLIST=
# BIRTH_SKY_PUBLIC_ENABLED=0

# Optional: weekly recap emails only (not used for signup verification)
# RESEND_API_KEY=
# EMAIL_FROM=AmyNest <hello@amynest.in>

# TTS: OpenAI only (gpt-4o-mini-tts). Pre-generate static catalog with pnpm run generate:static-audio
TTS_USE_GCS=false

# OpenAI / integrations (if used locally)
OPENAI_API_KEY=
AI_INTEGRATIONS_OPENAI_API_KEY=
AI_INTEGRATIONS_OPENAI_BASE_URL=
# Speech Coach V2 Realtime WebRTC (GA default: gpt-realtime; preview slugs are rejected)
# SPEECH_COACH_V2_REALTIME_MODEL=gpt-realtime

# ─── Web (Vite / kidschedule) ─────────────────────────────────────────────────
VITE_AMYNEST_ENV=development
# Point at local API: set VITE_USE_LOCAL_API=1 and leave origin unset, or set explicitly:
VITE_USE_LOCAL_API=1
VITE_APP_API_ORIGIN=http://localhost:5000
# Dev sign-in prefill (development only — never set in production)
VITE_DEMO_LOGIN_EMAIL=demo@amynest.in
VITE_DEMO_LOGIN_PASSWORD=AmyNest@2025

# Amy voice: optional ElevenLabs layer after OpenAI fails (needs ELEVENLABS_API_KEY on backend)
# TTS_ELEVENLABS_FALLBACK_ENABLED=true

# Static audio strict mode (dev only)
# VITE_STATIC_AUDIO_STRICT_MODE=true

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_VAPID_KEY=
# Co-parent invite UI (Phase 1 retired by default). Set to 1 with API flag to restore.
# VITE_FF_CO_PARENT=1
# Guest "Try first" (Android native) — opt-in. Requires Firebase Anonymous Auth enabled.
# VITE_FF_GUEST_TRY_FIRST=1

# Pre-signup re-engagement (Phase A: F1 native permission + F4 diagnostics). Parent OFF disables all.
# VITE_FF_PRE_SIGNUP_REENGAGEMENT=false
# VITE_FF_PRE_SIGNUP_PERM_NATIVE=true
# VITE_FF_PRE_SIGNUP_DIAGNOSTICS=true

# Google Analytics 4 — public marketing funnel (/get-app, /features, /guides)
# Create at https://analytics.google.com/ → Admin → Data Streams → Web
# VITE_GA4_MEASUREMENT_ID=G-XXXXXXXXXX

# ─── Expo mobile ─────────────────────────────────────────────────────────────
EXPO_PUBLIC_AMYNEST_ENV=development
EXPO_PUBLIC_USE_LOCAL_API=1
EXPO_PUBLIC_API_ORIGIN=http://localhost:5000
# Legacy alias (still supported):
# EXPO_PUBLIC_DOMAIN=localhost:5000

EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=

# ── Notification intelligence gate ────────────────────────────────────────────
# Governs the full intelligence gate for scheduled pushes: expected-value
# decision engine + copy-level Quality AI + unified Suppression engine, and logs
# persona / parent-value / lifecycle for analytics.
#   off      → no behavior change (default)
#   shadow   → evaluate + log every gate decision, but always dispatch (safe rollout)
#   enforce  → suppress sends the gate rejects (reduces fatigue / disables / uninstalls)
NOTIF_DECISION_ENGINE=off
