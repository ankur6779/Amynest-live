*.env
!.env*.example

# Service account / Firebase client JSON — never commit under attached_assets
attached_assets/*.json

# Google OAuth client secrets + promo automation runtime logs
client_secret*.json
**/client_secret_*.json
.secrets/
artifacts/promo-automation/

