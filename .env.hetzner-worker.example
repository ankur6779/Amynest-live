# Hetzner AI worker overrides — copy to hetzner-overrides.env (gitignored) or export before deploy.
# Production data plane is Coolify Postgres + Coolify Redis via Hetzner private network.

# Required: Coolify Redis via private-network socat proxy on Coolify host (10.0.0.2).
# Do NOT use public 188.245.208.126:6379 — closed after BSI exposure notice (2026-08-05).
REDIS_URL_EXTERNAL=redis://default:PASSWORD@10.0.0.2:6379

# Coolify Postgres via private-network socat proxy (bind=10.0.0.2 only).
# DATABASE_URL_EXTERNAL=postgresql://postgres:PASSWORD@10.0.0.2:5432/postgres

HETZNER_HOST=167.233.39.146
HETZNER_SSH_KEY=~/.ssh/id_ed25519_hetzner
