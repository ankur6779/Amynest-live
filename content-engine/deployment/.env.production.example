# AmyNest Content Engine — production environment template (Phase 10)
AMYNEST_ENV=production
AMYNEST_TIMEZONE=Asia/Kolkata
AMYNEST_DAILY_CRON=0 9 * * *
AMYNEST_SCHEDULER_BACKEND=coolify
AMYNEST_DATA_DIR=/data
AMYNEST_BACKUP_DIR=/backups
AMYNEST_OUTPUT_DIR=/renders
AMYNEST_LOG_LEVEL=info
AMYNEST_SECRET_VALIDATION_MODE=strict
AMYNEST_DAILY_VIDEO_COUNT=3
AMYNEST_WORKFLOW_CONCURRENCY=2
AMYNEST_HEALTHCHECK_ENABLED=true
AMYNEST_MONITORING_ENABLED=true
AMYNEST_BACKUP_ENABLED=true

# Providers (set mock for dry-run installs)
AMYNEST_SCRIPT_PROVIDER=openai
AMYNEST_RENDERER=ffmpeg
AMYNEST_PUBLISHING_PROVIDER=youtube
AMYNEST_ANALYTICS_PROVIDER=youtube
AMYNEST_TREND_PROVIDER=mock
AMYNEST_DEFAULT_VISIBILITY=public

# Secrets — never commit real values
OPENAI_API_KEY=
AI_INTEGRATIONS_OPENAI_API_KEY=
# Google AI Studio media stack (NOT the OpenAI GPT key)
GEMINI_API_KEY=
# Enable only after content-engine/docs/operations/TEST_GEMINI_REPORT.md is PASS
AMYNEST_GEMINI_ENABLED=false
AMYNEST_VEO_ENABLED=false
AMYNEST_VEO_TIER=daily
AMYNEST_VEO_MODEL=veo-3.1-fast-generate-preview
AMYNEST_GEMINI_SCRIPT_MODEL=gemini-3.6-flash
AMYNEST_GEMINI_IMAGE_MODEL=imagen-4.0-fast-generate-001
AMYNEST_GEMINI_TTS_MODEL=gemini-3.1-flash-tts-preview
AMYNEST_GEMINI_MUSIC_ENABLED=false
AMYNEST_SCRIPT_PROVIDER=openai
AMYNEST_FALLBACK_PROVIDER=mock
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
YOUTUBE_ACCESS_TOKEN=
YOUTUBE_CHANNEL_ID=
ANALYTICS_ACCESS_TOKEN=
AMYNEST_PROVIDER_FALLBACK_MODE=none
TELEGRAM_BOT_TOKEN=
WEBHOOK_URL=
SLACK_WEBHOOK_URL=
DISCORD_WEBHOOK_URL=
SMTP_URL=
SMTP_HOST=
SMTP_USER=
SMTP_PASS=
GOOGLE_TRENDS_API_KEY=
