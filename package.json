{
  "name": "workspace",
  "version": "0.0.0",
  "license": "MIT",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20.0.0 <23.0.0"
  },
  "scripts": {
    "preinstall": "echo ok",
    "postinstall": "node scripts/clean-vite-cache.mjs",
    "prepare": "sh -c 'command -v simple-git-hooks >/dev/null 2>&1 && simple-git-hooks || true'",
    "clean:vite": "node scripts/clean-vite-cache.mjs",
    "clean:web": "pnpm --filter @workspace/kidschedule run clean",
    "reset": "node scripts/clean-vite-cache.mjs --dist && pnpm install",
    "reset:hard": "rm -rf node_modules artifacts/kidschedule/node_modules artifacts/amynest-splash/node_modules && node scripts/clean-vite-cache.mjs --dist && pnpm install",
    "sync:main": "bash scripts/sync-local-main.sh",
    "dev": "pnpm run dev:api",
    "dev:api": "pnpm --filter @workspace/api-server dev",
    "dev:web": "pnpm --filter @workspace/kidschedule dev",
    "dev:mobile": "node -e \"console.error('Expo app archived at archive/amynest-mobile-expo. Use: pnpm dev:web + artifacts/amynest-capacitor (iOS/Android).'); process.exit(1)\"",
    "build:api": "pnpm --filter @workspace/api-server build",
    "start:api": "pnpm --filter @workspace/api-server start",
    "build": "pnpm run check:static-audio && pnpm run typecheck && pnpm -r --if-present run build",
    "build:web": "pnpm run check:static-audio && BASE_PATH=/ PORT=3000 pnpm --filter @workspace/kidschedule build",
    "db:migrate": "pnpm --filter @workspace/scripts run migrate-database",
    "db:push": "pnpm --filter @workspace/db push",
    "stress": "pnpm --filter @workspace/scripts run stress-amy-coach",
    "stability:load": "pnpm --filter @workspace/scripts run stability-load",
    "generate:content-bank": "pnpm --filter @workspace/scripts run generate:content-bank",
    "upload:content-bank": "pnpm --filter @workspace/scripts run upload:content-bank",
    "map:story-hub-gcs": "pnpm --filter @workspace/scripts run map:story-hub-gcs",
    "generate:reels-catalog": "pnpm --filter @workspace/scripts run generate:reels-catalog",
    "verify:reels-phase2b": "pnpm --filter @workspace/scripts run verify:reels-phase2b",
    "generate:content-bank-audio": "pnpm run scan:speakable-phrases && pnpm --filter @workspace/scripts run generate-static-audio -- --content-bank-only && pnpm --filter @workspace/scripts run build:content-bank-audio-map",
    "generate:static-audio": "pnpm --filter @workspace/scripts run generate-static-audio",
    "generate:static-audio:force": "pnpm --filter @workspace/scripts run generate-static-audio -- --force-all",
    "generate:static-audio:audio-lessons": "pnpm run scan:speakable-phrases && pnpm --filter @workspace/scripts run generate-static-audio -- --audio-lessons-only",
    "generate:static-audio:study-zone": "pnpm run scan:speakable-phrases && pnpm --filter @workspace/scripts run generate-static-audio -- --study-zone-only",
    "generate:static-audio:spelling": "pnpm run generate:spelling-audio",
    "generate:spelling-audio": "pnpm --filter @workspace/scripts run generate-spelling-audio",
    "build:audio-pack": "node scripts/build-local-audio-pack.mjs --tier minimal --force",
    "build:audio-pack:full": "node scripts/build-local-audio-pack.mjs --tier full --spelling-limit 500 --force",
    "build:infant-sleep-audio": "node scripts/build-infant-sleep-audio-pack.mjs --force",
    "validate:audio-pack": "node scripts/validate-local-audio-pack.mjs",
    "seed:audio-pack": "node scripts/seed-local-audio-pack-stubs.mjs",
    "build:spelling-manifest": "pnpm --filter @workspace/spelling-catalog run build:manifest",
    "build:spelling-audio-manifest": "pnpm --filter @workspace/scripts run build-spelling-audio-manifest",
    "check:spelling-audio": "pnpm --filter @workspace/scripts run check-spelling-audio",
    "generate:static-audio:parent-hub": "pnpm run scan:speakable-phrases && pnpm --filter @workspace/scripts run generate-static-audio -- --parent-hub-only",
    "generate:static-audio:speech-coach": "pnpm run scan:speakable-phrases && pnpm --filter @workspace/scripts run generate-static-audio -- --speech-coach-only",
    "generate:static-audio:phonics-static": "pnpm run scan:speakable-phrases && pnpm --filter @workspace/scripts run generate-static-audio -- --phonics-static-only",
    "generate:phonics-audio": "pnpm --filter @workspace/scripts run generate-phonics-audio",
    "generate:phonics-audio-demos": "pnpm --filter @workspace/scripts run generate-phonics-audio-demos",
    "normalize:phonics-audio": "pnpm --filter @workspace/scripts run normalize-phonics-audio",
    "approve:phonics-audio": "pnpm --filter @workspace/scripts run approve-phonics-audio",
    "check:phonics-audio": "pnpm --filter @workspace/scripts run check-phonics-audio",
    "clean:phonics-audio-legacy": "pnpm --filter @workspace/scripts run clean-phonics-audio-legacy",
    "generate:phonics-library": "pnpm --filter @workspace/scripts run generate-phonics-library",
    "generate:rhymes-registry": "node scripts/generate-rhymes-audio-registry.mjs",
    "audit:rhymes-gcs-audio": "node scripts/audit-rhymes-gcs-audio.mjs",
    "reencode:rhymes-gcs-audio": "node scripts/reencode-rhymes-gcs-audio.mjs",
    "dev:rhymes-ab-api": "node scripts/gcs-lullaby-audit-api.mjs",
    "generate:animal-world-audio": "pnpm --filter @workspace/scripts run generate-animal-world-audio",
    "generate:animal-world-real-heroes": "pnpm --filter @workspace/scripts run generate-animal-world-real-heroes",
    "sprint:animal-world-real-photos": "pnpm --filter @workspace/scripts run animal-world-real-photo-sprint",
    "upload:animal-world-visuals": "pnpm --filter @workspace/scripts run upload-animal-world-visuals",
    "generate:discovery-worlds-audio": "pnpm --filter @workspace/scripts run generate-discovery-worlds-audio",
    "generate:notification-sounds": "pnpm --filter @workspace/scripts run generate-notification-sounds",
    "generate:discovery-worlds-visuals": "pnpm --filter @workspace/scripts run generate-discovery-worlds-visuals",
    "upload:discovery-worlds-visuals": "pnpm --filter @workspace/scripts run upload-discovery-worlds-visuals",
    "upload:discovery-worlds-catalog": "pnpm --filter @workspace/scripts run upload-discovery-worlds-catalog",
    "generate:discovery-worlds-catalog": "cd lib/world-engine && node --import tsx/esm ../../scripts/generate-discovery-worlds-catalog.ts",
    "generate:animal-world-catalog": "cd lib/world-engine && node --import tsx/esm ../../scripts/generate-animal-world-catalog.ts",
    "report:discovery-worlds-assets": "cd lib/world-engine && node --import tsx/esm ../../scripts/discovery-worlds-asset-coverage.ts",
    "report:discovery-worlds-audio-qa": "cd lib/world-engine && node --import tsx/esm ../../scripts/discovery-worlds-audio-qa.ts",
    "validate:discovery-worlds": "cd lib/world-engine && node --import tsx/esm ../../scripts/discovery-worlds-launch-validation.ts",
    "report:discovery-worlds": "cd lib/world-engine && node --import tsx/esm ../../scripts/discovery-worlds-performance-report.ts",
    "report:discovery-worlds-performance": "cd lib/world-engine && node --import tsx/esm ../../scripts/discovery-worlds-performance-audit.ts --skip-build",
    "report:discovery-worlds-blockers": "cd lib/world-engine && node --import tsx/esm ../../scripts/discovery-worlds-launch-blocker-status.ts",
    "validate:discovery-worlds-audio-local": "cd lib/world-engine && node --import tsx/esm ../../scripts/validate-discovery-worlds-audio-local.ts",
    "check:phonics-library": "pnpm --filter @workspace/scripts run check-phonics-library",
    "check:phonics-audio-certification": "pnpm --filter @workspace/scripts run check-phonics-audio-certification",
    "phonics:audio:audit": "pnpm --filter @workspace/scripts run phonics-audio-audit",
    "phonics:audio:generate-missing": "pnpm --filter @workspace/scripts run phonics-audio-generate-missing",
    "phonics:audio:certify": "pnpm --filter @workspace/scripts run phonics-audio-certify",
    "check:phonics-release-gate": "pnpm --filter @workspace/scripts run check-phonics-release-gate",
    "check:phonics-interaction-gate": "pnpm --filter @workspace/scripts run check-phonics-interaction-gate",
    "check:crash-launch-gate": "pnpm --filter @workspace/scripts run check-crash-launch-gate",
    "check:audio-health-gate": "pnpm --filter @workspace/scripts run check-audio-health-gate",
    "crash:engineering-audit": "pnpm --filter @workspace/scripts run crash-engineering-audit",
    "crash:generate-review-packages": "pnpm --filter @workspace/scripts run generate-crash-review-packages",
    "release:intelligence": "pnpm --filter @workspace/scripts run release-intelligence",
    "backfill:spelling-static-audio": "pnpm run generate:spelling-audio",
    "check:static-audio": "pnpm --filter @workspace/scripts run check-static-audio",
    "check:audio-manifest-urls": "pnpm --filter @workspace/scripts run check-audio-manifest-urls",
    "normalize:audio-manifest-urls": "pnpm --filter @workspace/scripts run normalize-audio-manifest-urls",
    "load:audio": "pnpm --filter @workspace/scripts run audio-load-test",
    "tts-orphan:dry-run": "pnpm --filter @workspace/scripts run tts-orphan-dry-run",
    "audit:audio-modules": "pnpm --filter @workspace/scripts run audit-audio-modules",
    "report:static-audio-corpus": "node scripts/static-audio-corpus-report.mjs",
    "verify:audio-edge-cache": "node scripts/verify-audio-edge-cache.mjs",
    "check:audio-release-certification": "pnpm --filter @workspace/scripts run check-audio-release-certification",
    "check:audio-device-certification": "pnpm --filter @workspace/scripts run check-audio-device-certification",
    "scan:speakable-phrases": "pnpm --filter @workspace/scripts run scan-speakable-phrases",
    "check:amy-voice": "pnpm --filter @workspace/scripts run check-amy-voice-usage && pnpm --filter @workspace/kidschedule run check:amy-voice-contract && pnpm --filter @workspace/kidschedule exec vitest run src/lib/amy-speech-mode.test.ts src/lib/amy-voice-intent.test.ts src/lib/amy-voice-emotion.test.ts src/lib/amy-voice-teacher.test.ts src/lib/amy-voice-learning.test.ts src/lib/amy-voice-health.test.ts src/lib/amy-voice-golden.test.ts src/lib/amy-voice-field-validation.test.ts src/lib/amy-voice-cohorts.test.ts src/lib/amy-voice-experiments.test.ts src/lib/amy-voice-struggle-insights.test.ts src/lib/amy-voice-delivery-profile.test.ts src/lib/amy-voice-invariants.test.ts src/lib/amy-voice-governance.test.ts src/lib/amy-voice-personality.test.ts src/lib/amy-voice-controller.test.ts src/lib/amy-voice-playback-contract.test.ts src/lib/amy-voice-pipeline-optimizer.test.ts src/lib/amy-voice-pipeline-learning.test.ts src/lib/amy-voice-pipeline-server-sync.test.ts src/lib/amy-voice-rl-learning.test.ts src/lib/amy-voice-system-validation.test.ts",
    "check:speech-coach-engines": "pnpm run typecheck:libs && pnpm --filter @workspace/speech-coach test && pnpm --filter @workspace/scripts run check-speech-coach-engine-freeze && pnpm --filter @workspace/kidschedule exec vitest run src/lib/amy-speech-mode.test.ts src/lib/amy-voice-controller.test.ts src/lib/amy-voice-playback-contract.test.ts src/lib/global-audio-warmup.test.ts src/lib/phonics-player.test.ts src/lib/phonics-smoke.test.ts src/lib/phonics-manifest-validation.test.ts src/lib/static-audio-guard.test.ts src/lib/phonics-circuit-breaker.test.ts src/lib/phonics-safe-audio.test.ts",
    "check:chat-platform": "pnpm --filter @workspace/scripts run check-chat-platform && pnpm --filter @workspace/scripts run check-chat-thread && pnpm --filter @workspace/kidschedule exec vitest run src/lib/chat-platform-visibility.test.ts",
    "check:chat-platform-certification": "pnpm --filter @workspace/scripts run check-chat-platform-certification",
    "check:chat-platform-telemetry": "pnpm --filter @workspace/scripts run check-chat-platform-telemetry",
    "check:onboarding-completion": "pnpm --filter @workspace/scripts run check-onboarding-completion",
    "check:onboarding-health": "pnpm --filter @workspace/scripts run check-onboarding-health",
    "check:onboarding-regression": "pnpm --filter @workspace/kidschedule exec vitest run src/lib/auth-onboarding-regression.test.ts src/lib/onboarding-completion.test.ts src/lib/production-audit-regression.test.ts src/lib/google-auth.test.ts src/lib/facebook-auth.test.ts",
    "check:action-routing": "pnpm --filter @workspace/scripts run check-action-routing",
    "validate:amy-voice-field": "pnpm --filter @workspace/scripts run validate:amy-voice-field",
    "review:amy-voice-weekly": "pnpm --filter @workspace/scripts run review:amy-voice-weekly",
    "stability:api-unit": "pnpm --filter @workspace/api-server exec node --import tsx/esm --test src/lib/production-load.test.ts",
    "typecheck:libs": "tsc --build",
    "typecheck": "pnpm run typecheck:libs && pnpm -r --filter \"./artifacts/**\" --filter \"./scripts\" --if-present run typecheck",
    "codegen": "pnpm --filter @workspace/api-spec run codegen && pnpm run typecheck:libs"
  },
  "simple-git-hooks": {
    "pre-commit": "sh scripts/check-codegen.sh"
  },
  "private": true,
  "devDependencies": {
    "@babel/generator": "^7.29.1",
    "@babel/parser": "^7.29.3",
    "@babel/traverse": "^7.29.0",
    "@babel/types": "^7.29.0",
    "prettier": "^3.8.1",
    "simple-git-hooks": "^2.13.1",
    "typescript": "~5.9.2"
  },
  "dependencies": {
    "@replit/connectors-sdk": "^0.4.0",
    "@replit/revenuecat-sdk": "4.0.0"
  }
}
