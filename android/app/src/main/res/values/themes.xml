<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Edge-to-edge: do NOT set statusBarColor / navigationBarColor here —
      Play Console flags those APIs as deprecated on Android 15+.
      System bar styling is applied via Activity.enableEdgeToEdge().
    -->
    <style name="Theme.AmyNest" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowActionBar">false</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
    </style>
</resources>
