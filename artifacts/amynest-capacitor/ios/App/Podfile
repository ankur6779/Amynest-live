require_relative '../../../../node_modules/.pnpm/@capacitor+ios@6.2.1_@capacitor+core@6.2.1/node_modules/@capacitor/ios/scripts/pods_helpers'

# purchases-capacitor 13.x / RevenueCat 5.50+ — iOS 15+ for latest StoreKit switch coverage.
platform :ios, '15.0'
use_frameworks!

install! 'cocoapods', :disable_input_output_paths => true

def capacitor_pods
  pod 'Capacitor', :path => '../../../../node_modules/.pnpm/@capacitor+ios@6.2.1_@capacitor+core@6.2.1/node_modules/@capacitor/ios'
  pod 'CapacitorCordova', :path => '../../../../node_modules/.pnpm/@capacitor+ios@6.2.1_@capacitor+core@6.2.1/node_modules/@capacitor/ios'
  pod 'CapacitorCommunityAppleSignIn', :path => '../../../../node_modules/.pnpm/@capacitor-community+apple-sign-in@6.0.0_@capacitor+core@6.2.1/node_modules/@capacitor-community/apple-sign-in'
  pod 'CapacitorCommunityFacebookLogin', :path => '../../../../node_modules/.pnpm/@capacitor-community+facebook-login@6.1.2/node_modules/@capacitor-community/facebook-login'
  pod 'CapacitorApp', :path => '../../../../node_modules/.pnpm/@capacitor+app@6.0.3_@capacitor+core@6.2.1/node_modules/@capacitor/app'
  pod 'CapacitorGeolocation', :path => '../../../../node_modules/.pnpm/@capacitor+geolocation@6.1.1_@capacitor+core@6.2.1/node_modules/@capacitor/geolocation'
  pod 'CapacitorKeyboard', :path => '../../../../node_modules/.pnpm/@capacitor+keyboard@6.0.4_@capacitor+core@6.2.1/node_modules/@capacitor/keyboard'
  pod 'CapacitorPushNotifications', :path => '../../../../node_modules/.pnpm/@capacitor+push-notifications@6.0.5_@capacitor+core@6.2.1/node_modules/@capacitor/push-notifications'
  pod 'CapacitorStatusBar', :path => '../../../../node_modules/.pnpm/@capacitor+status-bar@6.0.3_@capacitor+core@6.2.1/node_modules/@capacitor/status-bar'
  pod 'CapgoCapacitorUpdater', :path => '../../../../node_modules/.pnpm/@capgo+capacitor-updater@6.45.10_@capacitor+core@6.2.1/node_modules/@capgo/capacitor-updater'
  pod 'CodetrixStudioCapacitorGoogleAuth', :path => '../../../../node_modules/.pnpm/@codetrix-studio+capacitor-google-auth@3.4.0-rc.4_@capacitor+core@6.2.1/node_modules/@codetrix-studio/capacitor-google-auth'
  pod 'RevenuecatPurchasesCapacitor', :path => '../../../../node_modules/.pnpm/@revenuecat+purchases-capacitor@13.1.1_@capacitor+core@6.2.1/node_modules/@revenuecat/purchases-capacitor'
  pod 'RevenuecatPurchasesCapacitorUi', :path => '../../../../node_modules/.pnpm/@revenuecat+purchases-capacitor-ui@13.1.1_@capacitor+core@6.2.1/node_modules/@revenuecat/purchases-capacitor-ui'
end

target 'App' do
  capacitor_pods
  # FCM push only — NOT Firebase/Core (pulls Analytics + Google Ads measurement).
  pod 'Firebase/CoreOnly'
  pod 'Firebase/Messaging'
end

def mark_cocoapods_scripts_always_run(project)
  return unless project
  project.targets.each do |target|
    target.build_phases.each do |phase|
      next unless phase.respond_to?(:name) && phase.name&.start_with?('[CP]')
      phase.always_out_of_date = '1'
    end
  end
  project.save
end

def suppress_fbsdk_deprecation_warnings(config)
  # FBSDKCoreKit 17.x still references StoreKit 1 APIs removed from iOS 18 SDK headers.
  # Harmless third-party noise until Meta ships a StoreKit-2-only SDK.
  config.build_settings['CLANG_WARN_DEPRECATED_DECLARATIONS'] = 'NO'
  config.build_settings['CLANG_WARN_DEPRECATED_OBJC_IMPLEMENTATIONS'] = 'NO'
  config.build_settings['GCC_WARN_INHIBIT_ALL_WARNINGS'] = 'YES'
  config.build_settings['SWIFT_SUPPRESS_WARNINGS'] = 'YES'

  swift_flags = config.build_settings['OTHER_SWIFT_FLAGS'] || '$(inherited)'
  unless swift_flags.to_s.include?('-suppress-warnings')
    swift_flags = "#{swift_flags} -suppress-warnings"
  end
  unless swift_flags.to_s.include?('-Xcc -Wno-deprecated-declarations')
    swift_flags = "#{swift_flags} -Xcc -Wno-deprecated-declarations"
  end
  config.build_settings['OTHER_SWIFT_FLAGS'] = swift_flags

  flags = config.build_settings['OTHER_CFLAGS'] || '$(inherited)'
  unless flags.to_s.include?('-Wno-deprecated-declarations')
    config.build_settings['OTHER_CFLAGS'] = "#{flags} -Wno-deprecated-declarations"
  end
end

def apply_pod_target_hygiene(config)
  config.build_settings['ENABLE_USER_SCRIPT_SANDBOXING'] = 'NO'
  config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '15.0'
  # Pin Swift 5 for all pods — Capgo/Alamofire/BigInt emit Swift 6-mode errors on Xcode 16+.
  config.build_settings['SWIFT_VERSION'] = '5.0'
  config.build_settings['SWIFT_STRICT_CONCURRENCY'] = 'off'
  config.build_settings['SWIFT_TREAT_WARNINGS_AS_ERRORS'] = 'NO'
  suppress_fbsdk_deprecation_warnings(config)
end

def patch_pods_app_xcconfigs(installer)
  marker = 'AMYNEST_FBSDK_WARNING_SUPPRESSION'
  suppression = <<~XCCONFIG

    // #{marker}
    CLANG_WARN_DEPRECATED_DECLARATIONS = NO
    CLANG_WARN_DEPRECATED_OBJC_IMPLEMENTATIONS = NO
    GCC_WARN_INHIBIT_ALL_WARNINGS = YES
    SWIFT_SUPPRESS_WARNINGS = YES
    OTHER_CFLAGS = $(inherited) -Wno-deprecated-declarations
    OTHER_SWIFT_FLAGS = $(inherited) -suppress-warnings -Xcc -Wno-deprecated-declarations
  XCCONFIG

  installer.aggregate_targets.each do |aggregate_target|
    aggregate_target.xcconfigs.each_key do |config_name|
      path = aggregate_target.xcconfig_path(config_name)
      next unless File.exist?(path)

      contents = File.read(path)
      next if contents.include?(marker)

      File.open(path, 'a') { |file| file.write(suppression) }
    end
  end
end

post_install do |installer|
  assertDeploymentTarget(installer)

  mark_cocoapods_scripts_always_run(installer.pods_project)
  installer.aggregate_targets.each do |aggregate_target|
    mark_cocoapods_scripts_always_run(aggregate_target.user_project)
  end

  installer.pods_project.targets.each do |target|
    target.build_configurations.each do |config|
      apply_pod_target_hygiene(config)
    end
  end

  installer.pods_project.build_configurations.each do |config|
    apply_pod_target_hygiene(config)
  end

  patch_pods_app_xcconfigs(installer)

  installer.aggregate_targets.each do |aggregate_target|
    aggregate_target.user_project.native_targets.each do |target|
      target.build_configurations.each do |config|
        config.build_settings['ENABLE_USER_SCRIPT_SANDBOXING'] = 'NO'
        config.build_settings['SWIFT_STRICT_CONCURRENCY'] = 'off'
        config.build_settings['SWIFT_VERSION'] = '5.0'
      end
    end
    aggregate_target.user_project.build_configurations.each do |config|
      config.build_settings['ENABLE_USER_SCRIPT_SANDBOXING'] = 'NO'
      config.build_settings['SWIFT_STRICT_CONCURRENCY'] = 'off'
    end
    aggregate_target.user_project.save
  end
end
