<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleDisplayName</key>
	<string>AmyNest</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>armv7</string>
	</array>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UIViewControllerBasedStatusBarAppearance</key>
	<false/>
	<key>UIUserInterfaceStyle</key>
	<string>Dark</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>AmyNest uses your microphone for the Speech Coach and pronunciation practice features.</string>
	<key>NSCameraUsageDescription</key>
	<string>AmyNest uses the camera to let you capture your child's milestones and share them in the app.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>AmyNest accesses your photo library to let you upload your child's photo for their profile.</string>
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>AmyNest saves milestone photos to your photo library.</string>
	<key>UIBackgroundModes</key>
	<array>
		<string>remote-notification</string>
		<string>fetch</string>
	</array>
	<key>NSFaceIDUsageDescription</key>
	<string>AmyNest can use Face ID to securely unlock your parenting data.</string>
	<key>NSContactsUsageDescription</key>
	<string>AmyNest accesses your contacts only when you choose to share a routine via the Share Routine feature.</string>
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsArbitraryLoadsInWebContent</key>
		<false/>
		<key>NSExceptionDomains</key>
		<dict>
			<key>amynest.in</key>
			<dict>
				<key>NSIncludesSubdomains</key>
				<true/>
				<key>NSExceptionAllowsInsecureHTTPLoads</key>
				<false/>
				<key>NSExceptionRequiresForwardSecrecy</key>
				<true/>
			</dict>
		</dict>
		<key>NSAllowsArbitraryLoads</key>
		<false/>
	</dict>
	<key>WKAppBoundDomains</key>
	<array>
		<string>amynest.in</string>
		<string>www.amynest.in</string>
		<string>clerk.amynest.in</string>
		<string>googleapis.com</string>
		<string>gstatic.com</string>
		<string>google.com</string>
		<string>firebaseapp.com</string>
		<string>www.gstatic.com</string>
		<string>www.google.com</string>
		<string>recaptcha.net</string>
		<string>www.recaptcha.net</string>
		<string>appleid.apple.com</string>
		<string>appleid.cdn-apple.com</string>
	</array>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>com.amynest.app</string>
				<string>capacitor</string>
			</array>
		</dict>
	</array>
	<key>UIStatusBarStyle</key>
	<string>UIStatusBarStyleLightContent</string>
	<key>WKAudiovisualMediaTypes</key>
	<string>none</string>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>AmyNest uses your location to show nearby school times, weather-aware routines, and local reminders.</string>
</dict>
</plist>
