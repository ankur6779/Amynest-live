<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">

<!--
  ╔══════════════════════════════════════════════════════════════════════╗
  ║  AmyNest — iOS Info.plist ADDITIONS                                 ║
  ║                                                                      ║
  ║  After running `npx cap add ios` on your Mac, open Xcode and add    ║
  ║  these keys into  ios/App/App/Info.plist  inside the root <dict>.    ║
  ╚══════════════════════════════════════════════════════════════════════╝
-->
<plist version="1.0">
<dict>

  <!-- ── Microphone (Amy Speech Coach read-aloud) ── -->
  <key>NSMicrophoneUsageDescription</key>
  <string>AmyNest uses your microphone for the Speech Coach and pronunciation practice features.</string>

  <!-- ── Camera ── -->
  <key>NSCameraUsageDescription</key>
  <string>AmyNest uses the camera to let you capture your child's milestones and share them in the app.</string>

  <!-- ── Photo Library (read) ── -->
  <key>NSPhotoLibraryUsageDescription</key>
  <string>AmyNest accesses your photo library to let you upload your child's photo for their profile.</string>

  <!-- ── Photo Library (add-only) ── -->
  <key>NSPhotoLibraryAddUsageDescription</key>
  <string>AmyNest saves milestone photos to your photo library.</string>

  <!-- ── Push Notifications (handled at runtime — no plist key needed, ──
       ── but the APS environment entitlement IS required in Entitlements) ── -->

  <!-- ── Background modes (push + background fetch only; no native background audio) ── -->
  <key>UIBackgroundModes</key>
  <array>
    <string>remote-notification</string>
    <string>fetch</string>
  </array>

  <!-- ── Face ID (future biometric lock) ── -->
  <key>NSFaceIDUsageDescription</key>
  <string>AmyNest can use Face ID to securely unlock your parenting data.</string>

  <!-- ── Contacts (optional — for sharing routines) ── -->
  <key>NSContactsUsageDescription</key>
  <string>AmyNest accesses your contacts only when you choose to share a routine via the Share Routine feature.</string>

  <!--
    ── App Transport Security ───────────────────────────────────────────
    Firebase Auth from inside WKWebView fetches identitytoolkit.googleapis.com
    and securetoken.googleapis.com. Explicit NSExceptionDomains entries
    prevent iOS from hanging the sign-in spinner forever on flaky networks.
    Each domain still requires TLS 1.2+ and forward secrecy (App Store-safe).
  -->
  <key>NSAppTransportSecurity</key>
  <dict>
    <key>NSAllowsArbitraryLoadsInWebContent</key>
    <false/>
    <key>NSAllowsArbitraryLoads</key>
    <false/>
    <key>NSExceptionDomains</key>
    <dict>
      <key>amynest.in</key>
      <dict>
        <key>NSIncludesSubdomains</key>
        <true/>
        <key>NSExceptionAllowsInsecureHTTPLoads</key>
        <false/>
        <key>NSExceptionRequiresForwardSecrecy</key>
        <true/>
      </dict>
      <key>googleapis.com</key>
      <dict>
        <key>NSIncludesSubdomains</key>
        <true/>
        <key>NSExceptionRequiresForwardSecrecy</key>
        <true/>
      </dict>
      <key>firebaseapp.com</key>
      <dict>
        <key>NSIncludesSubdomains</key>
        <true/>
        <key>NSExceptionRequiresForwardSecrecy</key>
        <true/>
      </dict>
      <key>firebaseio.com</key>
      <dict>
        <key>NSIncludesSubdomains</key>
        <true/>
        <key>NSExceptionRequiresForwardSecrecy</key>
        <true/>
      </dict>
      <key>gstatic.com</key>
      <dict>
        <key>NSIncludesSubdomains</key>
        <true/>
        <key>NSExceptionRequiresForwardSecrecy</key>
        <true/>
      </dict>
      <key>recaptcha.net</key>
      <dict>
        <key>NSIncludesSubdomains</key>
        <true/>
        <key>NSExceptionRequiresForwardSecrecy</key>
        <true/>
      </dict>
      <key>apple.com</key>
      <dict>
        <key>NSIncludesSubdomains</key>
        <true/>
        <key>NSExceptionRequiresForwardSecrecy</key>
        <true/>
      </dict>
    </dict>
  </dict>

  <!--
    ── WKAppBoundDomains (HARD CAP: 10 domains) ─────────────────────────
    Apple silently invalidates the entire array if it exceeds 10 entries.
    The Capacitor config sets `limitsNavigationsToAppBoundDomains: false`,
    so this list only opts the named domains into privileged WKWebView
    features (cookies / postMessage / localStorage in third-party iframes).
    Keep this list ≤ 10 and prioritise the auth-critical hosts.
  -->
  <key>WKAppBoundDomains</key>
  <array>
    <string>amynest.in</string>
    <string>googleapis.com</string>
    <string>gstatic.com</string>
    <string>google.com</string>
    <string>firebaseapp.com</string>
    <string>securetoken.googleapis.com</string>
    <string>identitytoolkit.googleapis.com</string>
    <string>recaptcha.net</string>
    <string>appleid.apple.com</string>
    <string>appleid.cdn-apple.com</string>
  </array>

  <!-- ── URL Schemes (Google Sign-In redirect) ── -->
  <key>CFBundleURLTypes</key>
  <array>
    <dict>
      <key>CFBundleURLSchemes</key>
      <array>
        <string>com.amynest.app</string>
        <string>capacitor</string>
        <string>com.googleusercontent.apps.573340015027-nhb24qka9h7gr06ri2muu9a7mrpf2c54</string>
      </array>
    </dict>
  </array>

  <!-- ── Status bar ── -->
  <key>UIStatusBarStyle</key>
  <string>UIStatusBarStyleLightContent</string>
  <key>UIViewControllerBasedStatusBarAppearance</key>
  <false/>
  <!-- Dark-only app — ignore iOS system light mode for native chrome + WKWebView -->
  <key>UIUserInterfaceStyle</key>
  <string>Dark</string>

  <!-- ── Orientation ── -->
  <key>UISupportedInterfaceOrientations</key>
  <array>
    <string>UIInterfaceOrientationPortrait</string>
    <string>UIInterfaceOrientationPortraitUpsideDown</string>
  </array>
  <key>UISupportedInterfaceOrientations~ipad</key>
  <array>
    <string>UIInterfaceOrientationPortrait</string>
    <string>UIInterfaceOrientationPortraitUpsideDown</string>
    <string>UIInterfaceOrientationLandscapeLeft</string>
    <string>UIInterfaceOrientationLandscapeRight</string>
  </array>

  <!-- ── Inline media (audio autoplay without user gesture) ── -->
  <key>WKAudiovisualMediaTypes</key>
  <string>none</string>

</dict>
</plist>
